# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_workflow_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security & JWT Configuration
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=949f57ebbfde4cbfa32135cc355df05fb04b9015c928b9d36a94f6f8bb1a48c5
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI Integration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Redis & Celery Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email Integration (IMAP / SMTP)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_EMAIL=your_email@gmail.com
IMAP_PASSWORD=your_app_password_here

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Mock Mode Configuration
# When MOCK_EMAIL_INBOX=True, the system simulates receiving unread emails 
# instead of connecting to a real IMAP server. Helpful for development and testing.
MOCK_EMAIL_INBOX=True
